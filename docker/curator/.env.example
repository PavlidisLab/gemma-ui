# Curator-laptop config. Copy to .env and edit before first up.
#
#   cp .env.example .env

# ─── required ────────────────────────────────────────────────────

# Remote Gemma 2.0 the proposer (if enabled) calls out to.
# Set to whatever URL bro publishes; defaults to staging.
GEMMA_BASE_URL=https://staging-gemma.msl.ubc.ca

# ─── optional ────────────────────────────────────────────────────

# Host port the curation UI binds on. Change if 5175 collides.
CURATION_UI_PORT=5175

# Bearer used by local-api + proposer. Default is a dev sentinel;
# override if your local-api was rebuilt with a different token.
GEMMA_CURATION_API_KEY=dev-token-123

# Only needed when running with ``--profile agents`` (the proposer
# service). Curators reviewing pre-built calibration packages can
# leave this unset.
ANTHROPIC_API_KEY=

# Image tags — override to pin a specific version. Leave at "latest"
# during early rollout.
LOCAL_API_IMAGE=gemma-curator/local-api:latest
CURATION_UI_IMAGE=gemma-curator/curation-ui:latest
