# Curator-distribution image for local_api.
#
# Baked-in source so the curator doesn't need a git checkout. We use
# Docker BuildKit "additional contexts" (compose ``additional_contexts``
# or ``docker build --build-context``) to pull the agents repo source
# in at build time without forcing the user to copy it under this
# tree — the agents repo lives parallel to this monorepo on the dev's
# machine, not nested.
#
# Build:
#   docker build \
#     --build-context agents=../../../gemma-curation-agents \
#     -f Dockerfile.local-api \
#     -t gemma-curator/local-api:latest .
#
# Run alone:
#   docker run --rm -p 8095:8000 -e GEMMA_CURATION_API_KEY=dev-token-123 \
#     gemma-curator/local-api:latest

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install --no-install-recommends -y \
        libgomp1 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /agents

# Three-step COPY for layer caching AND a correctly-populated
# editable install. ``pip install -e .`` walks the package dir at
# install time to build its editable-finder mapping; if the dir
# doesn't exist yet, the mapping is empty and ``import
# gemma_curation_agents`` fails at runtime even when the source is
# COPYed in later (caught 2026-05-25 — the original two-step
# pattern produced "ModuleNotFoundError: No module named
# 'gemma_curation_agents'" because pip wrote an empty mapping
# against the missing package dir). Mirror the local-mode
# Dockerfile.agents pattern: stub the package before install, then
# overlay the real source.
COPY --from=agents pyproject.toml ./pyproject.toml
COPY --from=agents README.md ./README.md
RUN mkdir -p gemma_curation_agents \
    && : > gemma_curation_agents/__init__.py \
    && pip install --upgrade pip \
    && pip install -e .

# The full source replaces the stub so the editable-install pointer
# (set during the install above) now resolves to the real module
# tree.
COPY --from=agents . .

# A writable spot for the SQLite + any imported calibration packages.
# Compose mounts a named volume here so data persists across
# container recreation.
ENV GEMMA_CURATION_SQLITE=/data/local_curation.sqlite
VOLUME ["/data"]
RUN mkdir -p /data

EXPOSE 8000

# Default command — overridden via compose to inject the port.
CMD ["python", "-m", "gemma_curation_agents.cli", "mock-gemma", "serve", "--host", "0.0.0.0", "--port", "8000"]
