# Curator-distribution image for the curation UI.
#
# Multi-stage:
#   1) node    — install deps + ``vite build`` produces static assets
#   2) nginx   — serves the SPA + proxies /rest/* to local-api
#
# Single port (80 inside, mapped by compose). No node runtime in the
# final image; no dev-server, no HMR.
#
# Build:
#   docker build \
#     -f Dockerfile.curation-ui \
#     -t gemma-curator/curation-ui:latest \
#     ../..

# ─── stage 1: build SPA ──────────────────────────────────────────
FROM node:20-slim AS build
WORKDIR /src

# Copy workspace manifests first for layer caching. ALL workspaces
# referenced by package.json::workspaces (``apps/*`` + ``packages/*``)
# need their package.json present before ``npm ci`` so the workspace
# graph resolves — without the packages/*/package.json files,
# ``@gemma/ui`` and the other internal packages 404 against the npm
# registry. v0.13.0 rebuild caught this (the packages/ workspaces
# landed during the 2026-06-15 refactor; the Dockerfile was still
# only copying the apps/ side).
COPY package.json package-lock.json* ./
COPY apps/curation/package.json apps/curation/package.json
COPY apps/browser/package.json apps/browser/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/ontology/package.json packages/ontology/package.json
COPY packages/heatmap/package.json packages/heatmap/package.json
COPY packages/diagnostics/package.json packages/diagnostics/package.json

# Install all workspaces (npm workspaces resolves both apps' deps).
RUN npm ci --no-audit --no-fund

# Now the source.
COPY . .

# Build-time env: lock the SPA to local mode + bake the dev bearer
# so the curator's first page-load doesn't prompt for HTTP Basic
# credentials. The SPA's ``resolveGemmaMode()`` checks
# VITE_GEMMA_MODE at build time; without it set, the auth chip
# defaults to "your Gemma login (HTTP Basic)" and every /rest
# call 401s through nginx because no bearer is attached.
# Override via --build-arg when shipping with a different bearer.
ARG VITE_GEMMA_MODE=local
ARG VITE_GEMMA_CURATION_API_KEY=dev-token-123
# Ontology-routing-exception host baked into the bundle so the
# OntologyTermPicker footer reads the same URL the proxy is
# forwarding to. Default empty → gemmaMode.ts falls back to its
# DEFAULT_ONTOLOGY_BASE (currently staging-gemma).
ARG VITE_GEMMA_ONTOLOGY_URL=
ENV VITE_GEMMA_MODE=$VITE_GEMMA_MODE
ENV VITE_GEMMA_CURATION_API_KEY=$VITE_GEMMA_CURATION_API_KEY
ENV VITE_GEMMA_ONTOLOGY_URL=$VITE_GEMMA_ONTOLOGY_URL

# Build only the curation app for this image.
#
# Skip ``tsc -b`` (the npm run build step's typecheck pass) — the
# main branch carries a backlog of pre-existing TS6133/TS2339/TS2345
# errors in test files + a few non-blocking real-code shadows that
# don't affect the shipped SPA's runtime behaviour. Production bundle
# is produced by ``vite build`` (esbuild transpilation), which is
# unaffected. v0.13.0 ship — clean-up tracked as a follow-up.
WORKDIR /src/apps/curation
RUN npx vite build

# ─── stage 2: serve via nginx ─────────────────────────────────────
FROM nginx:1.27-alpine

# Replace the default config with one that proxies /rest/* to the
# local-api service on the compose network.
COPY docker/curator/nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built SPA assets.
COPY --from=build /src/apps/curation/dist /usr/share/nginx/html

EXPOSE 80
