{
  "name": "gemma-ui",
  "private": true,
  "type": "module",
  "version": "0.11.0",
  "description": "Gemma user-facing frontends — apps/curation (curator workflow) + apps/browser (public browse/search).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev:curation": "npm --workspace gemma-curation-ui run dev",
    "dev:browser": "npm --workspace gembrow run dev",
    "build:curation": "npm --workspace gemma-curation-ui run build",
    "build:browser": "npm --workspace gembrow run build",
    "build": "npm run build:curation && npm run build:browser",
    "typecheck:curation": "npm --workspace gemma-curation-ui run typecheck",
    "typecheck:browser": "npm --workspace gembrow run typecheck",
    "typecheck": "npm run typecheck:curation && npm run typecheck:browser",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "test:curation": "npm --workspace gemma-curation-ui run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.59.4"
  }
}
