# Every variable this app reads, in one place. Copy to .env.local for
# dev; deployment values go in one file per target, named after the
# build mode that loads it:
#
#   .env.production      `vite build` / `scripts/deploy-browser.sh`
#   .env.staging         `--mode staging` / `deploy-browser.sh staging`
#   .env.gemma2testing   `--mode gemma2testing` / same, with that name
#
# Adding a deployment is adding one of these files; nothing keeps a
# list of them. Only the target's own file is read — a staging build
# never sees .env.production — so each one spells out every value it
# needs, and every file but .env.production also needs
# `NODE_ENV=production` (Vite treats any mode but "production" as
# non-production otherwise).
#
# Precedence, lowest to highest: .env.<mode> (that mode's builds only)
# → .env.local → a var exported in the shell.
#
# Only `VITE_`-prefixed vars reach client code. The two un-prefixed
# ones below are read by vite.config.ts / the deploy script at build
# time and never shipped to the browser.
#
# Uncommented lines are sensible dev defaults. Commented ones are
# optional — the comment says what the default behaviour is when unset,
# so you only set them to deviate from it.

# ── Dev server ───────────────────────────────────────────────────────

# Upstream the dev server's /rest proxy forwards to. Dev only: a
# production build has no proxy and talks to its own origin. No
# built-in default — set it explicitly or the proxy has nowhere to go.
GEMMA_BASE_URL=http://localhost:8080

# Poll for file changes instead of using inotify. Needed under
# docker-on-macOS, where bind-mounts don't deliver inotify events from
# host edits and HMR silently misses workspace-package changes. Costs
# CPU, so it's off unless set to exactly "1".
# VITE_USE_POLLING=1

# ── URLs the app uses ────────────────────────────────────────────────

# Absolute origin for links a human follows or pastes: the gemmapy /
# curl snippets, and rewriting ontology term URIs that point at the old
# gemma.msl.ubc.ca host. Must be a real reachable origin, never a proxy
# prefix that only resolves inside this app.
VITE_GEMMA_BASE_URL=https://gemma.msl.ubc.ca

# REST API root as the browser sees it. Unset = /rest/v2, i.e.
# same-origin — in dev that's the proxy above, in production it's
# whatever host serves the app.
#
# Set this only to move the API to a different *path* on that same
# origin (e.g. a reverse-proxy prefix). A cross-origin value cannot
# work: Gemma's CORS filter allow-lists only its own origin and 403s
# the preflight from anywhere else. It fails in the browser at runtime,
# not here at build time.
# VITE_GEMMA_API_URL=/rest/v2

# Internet-reachable Gemma base, for URLs handed to *third parties* —
# currently the UCSC genome-browser track link, which UCSC fetches from
# its own servers. Distinct from the two above, which only need to work
# from the visitor's browser.
#
# Unset falls back to this page's origin when that is https and not
# loopback, then to VITE_GEMMA_BASE_URL when that is https. Set it
# explicitly on a public plain-http host, where the https heuristic
# can't tell a public address from an internal one.
# VITE_GEMMA_PUBLIC_URL=

# Curation-app origin for the AppBar "Curation" tab and footer link.
# Unset defaults to http://localhost:5175, so those links only resolve
# on a machine running the curation dev server.
# VITE_CURATION_URL=

# ── Build + deploy ───────────────────────────────────────────────────

# Mount point for the built app. Unset (or "/") serves from an origin
# root; set it to the sub-path (e.g. /myapp/) when the build is mounted
# under one, and Vite prefixes every asset URL with it.
#
# A build is not portable across a change here: a bundle built for
# /myapp/ requests /myapp/assets/… and 404s at a root, and vice versa.
# Changing it means rebuild + redeploy, not moving files.
# VITE_BASE_PATH=/

# Where scripts/deploy-browser.sh publishes the build. No default — the
# script errors rather than guess. Read from .env.production /
# .env.staging in practice; it belongs with a deployment, not with dev
# config. The deploy runs rsync --delete, so this directory must hold
# nothing but this app's build output, and the two targets must not
# share one (the script checks and refuses).
# DEPLOY_DEST=/srv/www/gemma-browser
