# Copy to .env.local for dev. Production values live in
# .env.production (committed — public URLs, no secrets).

# Dev-server only: upstream the /rest proxy fronts. No default.
GEMMA_BASE_URL=http://localhost:8080

# Origin for absolute links into the legacy Gemma web app.
VITE_GEMMA_BASE_URL=https://gemma.msl.ubc.ca

# REST API root as the browser sees it. Unset = /rest/v2, i.e.
# same-origin — which in dev means the Vite proxy above, and in
# production means whatever host serves the app. Set it only to move
# the API to a different *path* on that same origin (e.g. a reverse
# proxy prefix). A cross-origin value does not work: Gemma's CORS
# filter allow-lists only its own origin.
# VITE_GEMMA_API_URL=/rest/v2

# Mount point for the built app. Leave unset (or "/") when serving
# from an origin root; set to the sub-path (e.g. /myapp/) when the
# build is mounted under one, so Vite prefixes every asset URL with
# it. Deployment values belong in .env.production, not here.
# VITE_BASE_PATH=/

# Curation-app origin for the AppBar "Curation" tab.
# Defaults to http://localhost:5175.
# VITE_CURATION_URL=
