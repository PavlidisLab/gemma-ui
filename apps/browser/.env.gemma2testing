# Testing build config for the gemma2.msl.ubc.ca host — read by
# `vite build --mode gemma2testing` and by
# `scripts/deploy-browser.sh gemma2testing`. Public URLs only, no
# secrets. A shell-exported var of the same name wins over anything
# here.
#
# What this is for: gemma2.msl.ubc.ca is the Gemma 2.0 host, and until
# 2026-09-03 it was what .env.production named. Production has since
# been renamed to gemma.msl.ubc.ca, which is a change of DNS/vhost the
# server has not made yet — so this file keeps the gemma2 spelling
# alive as its own deployment, for testing a build against that host
# without touching either of the other two.
#
# 🛑 gemma2.msl.ubc.ca currently serves /space/web/gemma-ui/production
# — the docroot the `production` target publishes to. This deployment
# deliberately does NOT publish there: two targets sharing a directory
# would make each deploy wipe the other (deploy-browser.sh checks for
# exactly that and refuses), and this is the testing build, not the
# live site.
#
# The consequence, stated plainly: nothing on gemma2 points at this
# directory yet, so a deploy here is invisible until an Alias or vhost
# is added for it. That is the server-side piece to arrange.
#
# Nothing in .env.production or .env.staging is loaded for this mode,
# so every value a build needs is spelled out here even where it
# matches another target.

# Vite treats a mode not literally named "production" as
# non-production unless NODE_ENV says otherwise: without this line the
# bundle keeps dev-only React warnings and `import.meta.env.PROD` is
# false. It is a real production build aimed at a testing host, so pin
# it.
NODE_ENV=production

# Mount point, baked into every asset URL at build time.
#
# "/" assumes this is served from an origin root. If it lands at a
# sub-path on gemma2 instead — the natural way to host it beside the
# live site, e.g. an Apache Alias making it
# gemma2.msl.ubc.ca/gemma2testing/ — set this to /gemma2testing/ and
# rebuild. A bundle built for one mount 404s at the other, which is
# why deploy-browser.sh greps dist/index.html for this prefix and
# refuses rather than shipping a mismatch.
#
# The REST root is unaffected either way: apiBase defaults to
# /rest/v2, which is origin-root-relative and independent of this.
VITE_BASE_PATH=/

# Where deploy-browser.sh publishes. Its own directory beside the
# other two targets, for the reason in the header. Must contain
# nothing but this app's build output: the deploy runs rsync --delete.
DEPLOY_DEST=/space/web/gemma-ui/gemma2testing

# Absolute origin for URLs a human follows or pastes — the gemmapy /
# curl snippets on the Browser page, and rewriting ontology term URIs
# that point at the old gemma.msl.ubc.ca host. gemma2, which is the
# point of this target: it is what the original production build said,
# and it is the host that actually answers Gemma 2.0 today. https, not
# http — gemma2 302s http → https, and a redirected snippet is a
# confusing thing to hand someone.
VITE_GEMMA_BASE_URL=https://gemma2.msl.ubc.ca

# Curation-app origin for the AppBar "Curation" tab / footer link.
# Deliberately unset — falls back to http://localhost:5175, so those
# links only work on a machine running the curation dev server.
# VITE_CURATION_URL=

# NOT set here, each deliberately:
#
# VITE_GEMMA_API_URL — unset means the /rest/v2 default in
#   src/api/base.ts, resolved against the app's own origin. Served
#   from gemma2, that IS gemma2's real REST API (verified
#   2026-08-17: GET /rest/v2/info → 200), so the default is right and
#   naming it would only add a second place to keep in sync. It holds
#   at a sub-path mount too, since that default is relative to the
#   origin and not to VITE_BASE_PATH.
#
#   This is also why the app is hosted on the Gemma host rather than
#   another box: gemma2's Tomcat CORS filter allow-lists exactly one
#   origin — itself — and 403s the preflight from anywhere else
#   (probed 2026-08-17). From gemma2 there is nothing to work around.
#
# VITE_GEMMA_PUBLIC_URL — the internet-reachable Gemma base, used for
#   URLs handed to third parties (the UCSC track link). Unset because
#   the app's own origin is already public https, which is what
#   publicGemmaUrl() falls back to.
#
# GEMMA_BASE_URL — configures the dev server's /rest proxy and nothing
#   else. A production-mode build has no proxy; the relative paths
#   above go straight to the serving origin.
