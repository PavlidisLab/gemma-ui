# Staging build config — read by `vite build --mode staging` and by
# `scripts/deploy-browser.sh staging`. Public URLs only, no secrets. A
# shell-exported var of the same name wins over anything here.
#
# Target: https://staging-gemma.msl.ubc.ca/
#         served from /space/web/gemma-ui/staging, alongside the
#         production tree in the same parent directory (plain static
#         files — no Tomcat, no container).
#
# NOT YET CONFIGURED on the server side: the host, the vhost and the
# Gemma instance behind it still have to be stood up. The values here
# are the intended shape, not a verified deployment — check them
# against reality before trusting a staging build.
#
# Nothing in .env.production is loaded for this mode, so every value a
# staging build needs has to be spelled out here, even where it would
# match production.


# No NODE_ENV line here, deliberately. `vite build` is a production
# build whatever `--mode` says: Vite sets NODE_ENV=production from the
# build command's own default before it reads this file, and a
# NODE_ENV in a .env file can only move it the other way, to
# development. Setting it to production earns the warning "NODE_ENV=
# production is not supported in the .env file" and changes nothing —
# verified by diffing two bundles. Vite's own "Modes" doc still shows
# that line; it was load-bearing in Vite <=4, not in 5.

# Mount point. Served from the origin root, so "/" — Vite emits
# root-absolute asset URLs (/assets/…). A bundle built for one mount
# 404s at another; changing this means rebuild + redeploy, not moving
# files.
VITE_BASE_PATH=/

# Where deploy-browser.sh publishes. Sibling of the production docroot,
# never the same directory: the deploy runs rsync --delete, so a shared
# path would make each target wipe the other (deploy-browser.sh checks
# for exactly that and refuses).
DEPLOY_DEST=/space/web/gemma-ui/staging

# Absolute origin for URLs a human follows or pastes — the gemmapy /
# curl snippets on the Browser page, and rewriting ontology term URIs
# that point at the old gemma.msl.ubc.ca host. Points at staging, not
# production: a snippet copied off the staging site should hit the
# staging API, or it is not testing anything.
VITE_GEMMA_BASE_URL=https://staging-gemma.msl.ubc.ca

# Curation-app origin for the AppBar "Curation" tab / footer link.
# Deliberately unset — falls back to http://localhost:5175. Set it once
# the curation app has a deployed staging URL.
# VITE_CURATION_URL=

# NOT set here, each deliberately:
#
# VITE_GEMMA_API_URL — unset means the /rest/v2 default in
#   src/api/base.ts, resolved against the app's own origin. That is
#   right only if staging-gemma serves a Gemma REST API from the same
#   origin as this app. If staging ends up as a static host in front of
#   a Gemma on another box, this needs an Origin-stripping reverse
#   proxy and this var pointed at its prefix — a plain cross-origin
#   value cannot work (Gemma's Tomcat CORS filter 403s the preflight).
#
# VITE_GEMMA_PUBLIC_URL — the internet-reachable Gemma base, used for
#   URLs handed to third parties (the UCSC track link). Unset falls back
#   to the app's own origin when that is https. Set it if staging is
#   served over plain http, where that heuristic can't tell public from
#   internal.
#
# GEMMA_BASE_URL — configures the dev server's /rest proxy and nothing
#   else. A production-mode build has no proxy; the relative paths above
#   go straight to the serving origin.
