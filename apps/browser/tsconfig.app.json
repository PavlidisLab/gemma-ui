{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@gemma/assets": ["../../packages/assets/src/index.ts"],
      "@gemma/diagnostics": ["../../packages/diagnostics/src/index.ts"],
      "@gemma/heatmap": ["../../packages/heatmap/src/index.ts"],
      "@gemma/ontology": ["../../packages/ontology/src/index.ts"],
      "@gemma/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/assets/src",
    "../../packages/diagnostics/src",
    "../../packages/heatmap/src",
    "../../packages/ontology/src",
    "../../packages/ui/src"
  ]
}
