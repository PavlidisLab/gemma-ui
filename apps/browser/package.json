{
  "name": "gembrow",
  "private": true,
  "version": "0.5.0-react.0",
  "type": "module",
  "description": "Public-facing browse/search frontend for Gemma (React rewrite).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check:annotations": "node scripts/check-annotation-contract.mjs",
    "emit:favicon": "node ../../packages/assets/scripts/emit-favicon.mjs --variant colour --out public/favicon.svg",
    "emit:mark-component": "node ../../packages/assets/scripts/emit-mark-component.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:critical": "playwright test --grep '@critical'",
    "test:ci": "vitest run && playwright test --grep '@critical'"
  },
  "dependencies": {
    "@gemma/assets": "*",
    "@gemma/diagnostics": "*",
    "@gemma/heatmap": "*",
    "@gemma/ontology": "*",
    "@gemma/ui": "*",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.95.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "marked": "^14.1.3",
    "pluralize": "^8.0.0",
    "qs": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "title-case": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tanstack/router-devtools": "^1.95.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/pluralize": "^0.0.33",
    "@types/qs": "^6.9.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.5"
  }
}
