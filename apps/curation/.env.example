# Mock curation API base URL (or real Gemma later).
GEMMA_CURATION_URL=http://localhost:8080
# Bearer token sent to the curation API.
VITE_GEMMA_CURATION_API_KEY=dev-token-123

# Proposer service base URL (FastAPI in gemma-curation-agents).
# Backs the +propose, /find-publication, /find-term endpoints.
GEMMA_PROPOSER_URL=http://localhost:8090

# Gemma web base URL — used for "view on Gemma" / audit-trail /
# platform-page deep links. Default is production; set to
# https://staging-gemma.msl.ubc.ca for preview builds.
VITE_GEMMA_WEB_URL=https://gemma.msl.ubc.ca
