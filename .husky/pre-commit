#!/usr/bin/env bash
# Critical-test gate. Runs on every commit; fails the commit if the
# regression tests don't pass.
#
# Scope, per app: ``tsc --noEmit`` PLUS vitest unit + render tests
# (fast — ~5 s) PLUS, for apps/curation, the ``@critical``-tagged
# Playwright specs.
#
# apps/browser joined the gate on 2026-08-22. It had a test file
# (``src/lib/baseline.test.ts``) and no runner to execute it, so
# nothing in that app had ever been checked by anything but a human
# looking at it.
#
# Typecheck is first because it is the cheapest and because vitest
# STRIPS types rather than checking them — a broken cast in a test
# file passes every test it contains. One rode in on a green commit
# (``fvShapedTagFindings.test.ts``, 89fd92e → caught 2026-08-13) and
# nothing in the gate was looking. It must name ``tsconfig.app.json``:
# the root ``tsconfig.json`` has empty ``files`` and checks nothing.
#
# The full Playwright run is
# too slow for a precommit gate; ``@critical`` is the narrow set
# that pins behaviour we've broken before — finding-card titles,
# action-row buttons, dismiss-dialog vocab — and would catch the
# same shape of regression on the next commit.
#
# The @critical specs are DATA-MOCKED (HAR replay, see e2e/_mocks.ts),
# so this gate is deterministic and does NOT depend on a live backend.
# ``--grep-invert @live`` is belt-and-suspenders: backend-integration
# specs (@live) never block a commit — they run via ``npm run e2e:live``
# when the store is up.
#
# Skipping the gate: ``git commit --no-verify`` (use sparingly; the
# next commit re-runs all of it). When the gate fires a false
# positive, fix the test rather than the bypass — see the test
# files' headers for the contract each one pins.
# Husky runs this with `sh`, and Linux `/bin/sh` doesn't have `pipefail`.
set -eu

repo_root=$(pwd)

# ─── source stays greppable ──────────────────────────────────────
# 🛑 A literal NUL byte makes BSD grep (the macOS default) treat the
# whole file as binary: it exits 1 and prints NOTHING — no matches, no
# "Binary file … matches" line, nothing on stderr. It fails OPEN, so a
# search for a helper inside reads as "that does not exist", and the
# next person writes a second one. Three files in apps/curation used a
# raw NUL as a join separator and were invisible this way.
#
# The escape `\u0000` is the same character at runtime and keeps the
# file plain text, so the fix costs nothing.
echo "[pre-commit] source stays greppable (no literal NUL bytes)"
nul_hits=""
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' '*.js' '*.mjs' '*.json' '*.md' '*.css' '*.html'); do
    [ -f "$f" ] || continue
    if ! LC_ALL=C tr -d '\000' < "$f" | cmp -s - "$f"; then
        nul_hits="$nul_hits $f"
    fi
done
if [ -n "$nul_hits" ]; then
    echo "[pre-commit] literal NUL byte in:$nul_hits"
    echo "[pre-commit] grep answers every search in that file with silence."
    echo "[pre-commit] Write the separator as the escape \\u0000 instead."
    exit 1
fi

# ─── apps/browser ────────────────────────────────────────────────
# Cheap (~7 s): typecheck plus pure-function unit tests. No DOM, no
# Playwright — see apps/browser/vitest.config.ts.
cd "$repo_root/apps/browser"

echo "[pre-commit] browser: tsc --noEmit"
npx tsc -p tsconfig.app.json --noEmit

echo "[pre-commit] browser: vitest run"
npx vitest run --silent

# ─── apps/curation ───────────────────────────────────────────────
cd "$repo_root/apps/curation"

echo "[pre-commit] tsc --noEmit"
npx tsc -p tsconfig.app.json --noEmit

echo "[pre-commit] vitest run (unit + render)"
npx vitest run --silent

# Playwright @critical specs — only run if a Playwright browser is
# already installed (curators / freshly-cloned dev shells without
# Chromium shouldn't be blocked). The check is cheap.
if [ -d "$HOME/Library/Caches/ms-playwright" ] || [ -d "$HOME/.cache/ms-playwright" ]; then
    echo "[pre-commit] playwright @critical specs (mocked, no backend)"
    npx playwright test --grep '@critical' --grep-invert '@live' --reporter=line || {
        echo "[pre-commit] @critical e2e failed."
        echo "[pre-commit] To bypass once: git commit --no-verify"
        exit 1
    }
else
    echo "[pre-commit] skipping playwright @critical (no browser cache present)"
fi
